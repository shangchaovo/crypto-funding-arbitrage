<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.local.funding-rates-updater</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__HOME__/funding-arb-build/scripts/update-rates-cron.sh</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__HOME__/funding-arb-build</string>

  <!-- 每 10 分钟刷新一次,保证公共站兜底缓存始终 <15min(陈旧阈值)之内 -->
  <key>StartInterval</key>
  <integer>600</integer>

  <key>RunAtLoad</key>
  <true/>

  <key>StandardOutPath</key>
  <string>__HOME__/funding-arb-build/logs/rates-updater.log</string>

  <key>StandardErrorPath</key>
  <string>__HOME__/funding-arb-build/logs/rates-updater.log</string>
</dict>
</plist>
