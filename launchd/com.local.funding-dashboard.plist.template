<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.local.funding-dashboard</string>

  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/node</string>
    <string>__HOME__/funding-arb-build/server.js</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__HOME__/funding-arb-build</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PORT</key>
    <string>8768</string>
    <key>NODE_ENV</key>
    <string>production</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <true/>

  <key>ThrottleInterval</key>
  <integer>10</integer>

  <key>StandardOutPath</key>
  <string>__HOME__/funding-arb-build/logs/server.out.log</string>

  <key>StandardErrorPath</key>
  <string>__HOME__/funding-arb-build/logs/server.err.log</string>
</dict>
</plist>
